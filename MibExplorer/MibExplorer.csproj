<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>MibExplorer</RootNamespace>
    <AssemblyName>MibExplorer</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <None Remove="Assets\app.png" />
    <None Remove="Assets\throbber.gif" />

    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\throbber.gif">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- Embed all terminal resources in MibExplorer.dll, and therefore in the single-file EXE. -->
    <!-- WebView2 receives these resources from the assembly; no Assets folder is distributed. -->
    <None Remove="Assets\Terminal\**\*" />
    <Content Remove="Assets\Terminal\**\*" />
    <EmbeddedResource Include="Assets\Terminal\index.html" LogicalName="MibExplorer.Terminal.index.html" />
    <EmbeddedResource Include="Assets\Terminal\bridge.js" LogicalName="MibExplorer.Terminal.bridge.js" />
    <EmbeddedResource Include="Assets\Terminal\terminal.css" LogicalName="MibExplorer.Terminal.terminal.css" />
    <EmbeddedResource Include="Assets\Terminal\vendor\xterm.js" LogicalName="MibExplorer.Terminal.xterm.js" />
    <EmbeddedResource Include="Assets\Terminal\vendor\xterm.css" LogicalName="MibExplorer.Terminal.xterm.css" />
    <EmbeddedResource Include="Assets\Terminal\vendor\addon-fit.js" LogicalName="MibExplorer.Terminal.addon-fit.js" />
    <EmbeddedResource Include="Assets\Terminal\vendor\xterm.LICENSE" LogicalName="MibExplorer.Terminal.xterm.LICENSE" />
    <EmbeddedResource Include="Assets\Terminal\vendor\addon-fit.LICENSE" LogicalName="MibExplorer.Terminal.addon-fit.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payload\sshd.zip" />
    <EmbeddedResource Include="Payload\sshd.zip">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\Coding\mib2_5f_coding_catalog.json" />
    <EmbeddedResource Include="Data\Coding\mib2_5f_coding_catalog.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\Adaptations\adaptations_catalog.json" />
    <EmbeddedResource Include="Data\Adaptations\adaptations_catalog.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payload\CodingCenter\Read\run.sh" />
    <None Remove="Payload\CodingCenter\Read\dumb_persistence_reader" />
    <None Remove="Payload\CodingCenter\Write\run.sh" />
    <None Remove="Payload\CodingCenter\Write\pc" />
    <None Remove="Payload\CodingCenter\Write\dumb_persistence_reader" />

    <EmbeddedResource Include="Payload\CodingCenter\Read\run.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\CodingCenter\Read\dumb_persistence_reader">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\CodingCenter\Write\run.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\CodingCenter\Write\pc">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\CodingCenter\Write\dumb_persistence_reader">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payload\AdaptationsCenter\Read\run.sh" />
    <None Remove="Payload\AdaptationsCenter\Read\pc" />
    <None Remove="Payload\AdaptationsCenter\Vin\run.sh" />
    <None Remove="Payload\AdaptationsCenter\Write\run.sh" />
    <None Remove="Payload\AdaptationsCenter\Write\pc" />

    <EmbeddedResource Include="Payload\AdaptationsCenter\Read\run.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\AdaptationsCenter\Read\pc">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\AdaptationsCenter\Vin\run.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\AdaptationsCenter\Write\run.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="Payload\AdaptationsCenter\Write\pc">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>