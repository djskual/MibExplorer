<Window x:Class="MibExplorer.Views.Adaptations.AdaptationsCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:models="clr-namespace:MibExplorer.Models.Adaptations"
        Title="Adaptations Center"
        Width="1180"
        Height="720"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="Manual"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.Resources>
        <GridLength x:Key="AdaptationColumnWidth">450</GridLength>
        <GridLength x:Key="CurrentColumnWidth">275</GridLength>
        <GridLength x:Key="NewValueColumnWidth">230</GridLength>
        <GridLength x:Key="UnitColumnWidth">90</GridLength>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Adaptations Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,4,0,0">
                    <TextBlock Text="ODIS-visible adaptation catalog V4 preview. Writes are still disabled."
                               Foreground="{DynamicResource AppMutedTextBrush}"/>

                    <TextBlock Text="  VIN: "
                               Foreground="{DynamicResource AppMutedTextBrush}"/>

                    <TextBlock Text="{Binding CurrentVin}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Image Width="24"
                       Height="24"
                       Margin="0,0,10,0"
                       gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/throbber.gif"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <CheckBox Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowDiagnostics, Mode=TwoWay}"
                          Content="Diagnostics"/>

                <Button MinWidth="95"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding ApplyCommand}"
                        Content="Apply"/>

                <Button MinWidth="95"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding DiscardCommand}"
                        Content="Discard"/>
            </StackPanel>

        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Height="34"
                        Width="380"
                        Background="{DynamicResource AppControlBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search icon -->
                        <Viewbox Grid.Column="0"
                                 Width="15"
                                 Height="15"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Ellipse Width="9"
                                         Height="9"
                                         Canvas.Left="2"
                                         Canvas.Top="2"
                                         Stroke="{DynamicResource AppMutedTextBrush}"
                                         StrokeThickness="1.8"/>
                                <Line X1="9"
                                      Y1="9"
                                      X2="14"
                                      Y2="14"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 CaretBrush="{DynamicResource AppTextBrush}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,6,0"/>

                        <!-- Clear icon -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                ToolTip="Clear search">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="12" Height="12">
                                    <Line X1="2"
                                          Y1="2"
                                          X2="10"
                                          Y2="10"
                                          Stroke="{DynamicResource AppMutedTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Line X1="10"
                                          Y1="2"
                                          X2="2"
                                          Y2="10"
                                          Stroke="{DynamicResource AppMutedTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Expand groups to read adaptations from the MIB. Apply is manual; closing a dirty group discards its pending edits."
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="4"
                    Background="Transparent"
                    BorderThickness="0">

            <TabItem Header="Edit">
                <Border Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                          Margin="72,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource AdaptationColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource CurrentColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource NewValueColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource UnitColumnWidth}"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Adaptation"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Current"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="New value"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Unit"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </Grid>

                    <TreeView x:Name="AdaptationsTree"
                              ItemsSource="{Binding GroupsView}"
                              SelectedItemChanged="AdaptationsTree_SelectedItemChanged"
                              TreeViewItem.Expanded="AdaptationsTree_ItemExpanded"
                              PreviewMouseWheel="AdaptationsTree_PreviewMouseWheel"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource AppTextBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppTextBrush}"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="HorizontalAlignment"
                                        Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <Border x:Name="HeaderBorder"
                                                        Grid.Row="0"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="0">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Margin="18,0,0,0"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HeaderBorder"
                                                            Property="Background"
                                                            Value="#2F4F7F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:AdaptationGroupView}"
                                                      ItemsSource="{Binding AdaptationsView}">
                                <Grid Margin="0,3"
                                      HorizontalAlignment="Stretch"
                                      MouseLeftButtonDown="GroupHeader_MouseLeftButtonDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ExpandGlyph}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding HeaderText}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <Image Grid.Column="2"
                                           Width="16"
                                           Height="16"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/throbber.gif"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Ellipse Grid.Column="4"
                                             Width="8"
                                             Height="8"
                                             Margin="4,0,0,0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="#4DA3FF"
                                             ToolTip="This group has pending changes"
                                             Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Grid.Column="5"
                                            Width="46"
                                            Height="24"
                                            Margin="4,0,6,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip="Reload this group"
                                            Command="{Binding DataContext.ReloadCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="GroupReloadButton_Click">
                                        <TextBlock Text="↻"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type models:AdaptationItemView}">
                                <Grid Margin="42,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource AdaptationColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource CurrentColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource NewValueColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidth}"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0"
                                                     Width="13"
                                                     Height="13"
                                                     Margin="0,1,5,0"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding StorageMappedToolTip}">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsStorageMapped}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>

                                                <Canvas Width="16" Height="16">
                                                    <Ellipse Width="16"
                                                             Height="16"
                                                             Fill="#2EA043"/>
                                                    <Path Data="M4.2,8.4 L6.8,11 L12.2,5.2"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextBrush}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding DiagnosticSummary}"
                                                   Margin="18,2,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DiagnosticSummary}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentValue}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CurrentValue}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <Grid Grid.Column="2">
                                        <ComboBox Height="26"
                                                  Width="220"
                                                  ItemsSource="{Binding EditOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Label"
                                                  SelectedValue="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="ComboBox_SelectionChanged"
                                                  PreviewKeyDown="Editor_PreviewKeyDown"
                                                  Visibility="{Binding IsComboEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsNumericEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 PreviewKeyDown="Editor_PreviewKeyDown"
                                                 PreviewTextInput="NumericBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericBox_Pasting"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsTextEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 PreviewKeyDown="Editor_PreviewKeyDown"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 CharacterCasing="Upper"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsHexBytesEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 PreviewKeyDown="Editor_PreviewKeyDown"/>

                                        <TextBlock Text="Read only"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="{Binding IsReadOnlyEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Unit}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="History">
                <Border Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="230"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding HistoryEntryCount, StringFormat=History: {0} transaction(s)}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}"/>

                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding HistoryEntries}"
                                  SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="150"
                                                    DisplayMemberBinding="{Binding CreatedAtDisplay}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="Date"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="360"
                                                    DisplayMemberBinding="{Binding OdisGroupDisplay}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="ODIS group"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="130"
                                                    DisplayMemberBinding="{Binding Status}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="Status"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="180"
                                                    DisplayMemberBinding="{Binding PhysicalKey}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="Physical key"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="230"
                                                    DisplayMemberBinding="{Binding Summary}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="Summary"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="4"
                                Background="{DynamicResource AppPanelBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Visibility="{Binding HasSelectedHistoryEntry, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Grid DataContext="{Binding SelectedHistoryEntry}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="120"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Transaction details"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <Button Grid.Column="1"
                                            MinWidth="90"
                                            Height="28"
                                            Padding="12,0"
                                            Content="Restore"
                                            ToolTip="Create a reverse transaction from this history entry"
                                            Command="{Binding DataContext.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Physical key:"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding PhysicalKey}"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="Status:"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                               Text="{Binding Status}"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Original raw:"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding OriginalRawValue}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="Merged raw:"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3"
                                               Text="{Binding MergedRawValue}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Readback:"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding ReadbackRawValue}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                </Grid>

                                <ListView Grid.Row="4"
                                          ItemsSource="{Binding Changes}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource AppTextBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>

                                            <GridViewColumn Width="360"
                                                            DisplayMemberBinding="{Binding Label}">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="Adaptation"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               FontWeight="SemiBold"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>

                                            <GridViewColumn Width="350"
                                                            DisplayMemberBinding="{Binding CurrentValue}">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="Before"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               FontWeight="SemiBold"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>

                                            <GridViewColumn Width="350"
                                                            DisplayMemberBinding="{Binding NewValue}">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="After"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               FontWeight="SemiBold"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>

                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="6"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
    </Grid>
</Window>