<Window x:Class="MibExplorer.Views.Adaptations.AdaptationsCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:models="clr-namespace:MibExplorer.Models.Adaptations"
        Title="Adaptations Center"
        Width="1180"
        Height="720"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="Manual"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.Resources>
        <GridLength x:Key="AdaptationColumnWidth">450</GridLength>
        <GridLength x:Key="CurrentColumnWidth">275</GridLength>
        <GridLength x:Key="NewValueColumnWidth">230</GridLength>
        <GridLength x:Key="UnitColumnWidth">90</GridLength>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Adaptations Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <TextBlock Text="ODIS-visible adaptation catalog V4 preview. Writes are still disabled."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Image Width="24"
                       Height="24"
                       Margin="0,0,10,0"
                       gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/throbber.gif"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <CheckBox Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowDiagnostics, Mode=TwoWay}"
                          Content="Diagnostics"/>

                <Button MinWidth="95"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding ApplyCommand}"
                        Content="Apply"/>

                <Button MinWidth="95"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding DiscardCommand}"
                        Content="Discard"/>

                <Button MinWidth="115"
                        Height="34"
                        Padding="14,0"
                        Command="{Binding ReloadCommand}"
                        Content="Reload group"/>
            </StackPanel>

        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Height="34"
                        Width="380"
                        Background="{DynamicResource AppControlBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search icon -->
                        <Viewbox Grid.Column="0"
                                 Width="15"
                                 Height="15"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Ellipse Width="9"
                                         Height="9"
                                         Canvas.Left="2"
                                         Canvas.Top="2"
                                         Stroke="{DynamicResource AppMutedTextBrush}"
                                         StrokeThickness="1.8"/>
                                <Line X1="9"
                                      Y1="9"
                                      X2="14"
                                      Y2="14"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 CaretBrush="{DynamicResource AppTextBrush}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,6,0"/>

                        <!-- Clear icon -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                ToolTip="Clear search">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="12" Height="12">
                                    <Line X1="2"
                                          Y1="2"
                                          X2="10"
                                          Y2="10"
                                          Stroke="{DynamicResource AppMutedTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Line X1="10"
                                          Y1="2"
                                          X2="2"
                                          Y2="10"
                                          Stroke="{DynamicResource AppMutedTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Expand a group to read its adaptations from the MIB."
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource AppPanelBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">

                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          Margin="72,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource AdaptationColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource CurrentColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource NewValueColumnWidth}"/>
                            <ColumnDefinition Width="{StaticResource UnitColumnWidth}"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Adaptation"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Current"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="New value"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Unit"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </Grid>

                    <TreeView x:Name="AdaptationsTree"
                              ItemsSource="{Binding GroupsView}"
                              SelectedItemChanged="AdaptationsTree_SelectedItemChanged"
                              TreeViewItem.Expanded="AdaptationsTree_ItemExpanded"
                              PreviewMouseWheel="AdaptationsTree_PreviewMouseWheel"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource AppTextBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppTextBrush}"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <Border x:Name="HeaderBorder"
                                                        Grid.Row="0"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="0">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"/>
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Margin="18,0,0,0"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HeaderBorder"
                                                            Property="Background"
                                                            Value="#2F4F7F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:AdaptationGroupView}"
                                                      ItemsSource="{Binding AdaptationsView}">
                                <Grid Margin="0,3"
                                      MouseLeftButtonDown="GroupHeader_MouseLeftButtonDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ExpandGlyph}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding HeaderText}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <Image Grid.Column="2"
                                           Width="16"
                                           Height="16"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/throbber.gif"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type models:AdaptationItemView}">
                                <Grid Margin="42,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource AdaptationColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource CurrentColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource NewValueColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidth}"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Label}"
                                                   Foreground="{DynamicResource AppTextBrush}"/>

                                        <TextBlock Text="{Binding DiagnosticSummary}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DiagnosticSummary}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentValue}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CurrentValue}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextBrush}"/>

                                    <Grid Grid.Column="2">
                                        <ComboBox Height="26"
                                                  Width="220"
                                                  ItemsSource="{Binding EditOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedEditOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding IsComboEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsNumericEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 PreviewTextInput="NumericBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericBox_Pasting"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsTextEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBox Height="30"
                                                 MinHeight="30"
                                                 Width="220"
                                                 CharacterCasing="Upper"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsHexBytesEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBlock Text="Read only"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="{Binding IsReadOnlyEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Unit}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
    </Grid>
</Window>