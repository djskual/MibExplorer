<Window x:Class="MibExplorer.Views.Dialogs.RebootMibReconnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reconnecting to MIB"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        Closing="Window_Closing">
    <StackPanel Margin="20">
        <TextBlock Text="Waiting for MIB reboot" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="TimeLeftText" Margin="0,10,0,0"/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="180" Height="9" Margin="0,12,0,0"/>
        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
        <Button x:Name="CancelReconnectButton" Content="Cancel auto reconnect" Width="175"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="Cancel_Click"/>
    </StackPanel>
</Window>
