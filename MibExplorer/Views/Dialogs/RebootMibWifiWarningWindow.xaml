<Window x:Class="MibExplorer.Views.Dialogs.RebootMibWifiWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto reconnect unavailable"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="Automatic Wi-Fi reconnect is unavailable"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap"
                   Text="MibExplorer could not read the current Wi-Fi profile. Windows may block this when Location access is disabled."/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="To enable it: Windows Settings > Privacy &amp; security > Location. Turn on Location services and allow desktop apps to access location."/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="You can still reboot now, but Wi-Fi and SSH will not reconnect automatically."/>
        <TextBlock x:Name="NetworkDiagnosticText" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Location settings" Width="130" Margin="0,0,8,0" Click="OpenSettings_Click"/>
            <Button Content="Reboot without reconnect" Width="195" Margin="0,0,8,0" Click="RebootWithoutReconnect_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
